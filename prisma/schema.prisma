
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  library      Library[]
  notes        Note[]
  progress     VideoProgress[]
}


model Library {
  id        String   @id @default(cuid())

  userId    String

  // YouTube information
  videoId   String
  title     String
  channel   String?
  thumbnail String?
  duration  Int?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes    Note[]
  progress VideoProgress?

  @@unique([userId, videoId])

  @@index([userId])
  @@index([videoId])
}


model Note {
  id        String   @id @default(cuid())

  userId    String
  libraryId String

  // Timestamp in seconds from beginning of video
  timestamp Int

  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([libraryId])
  @@index([libraryId, timestamp])
}

model VideoProgress {
  id        String   @id @default(cuid())

  userId    String
  libraryId String @unique

  watchedSeconds  Int @default(0)
  durationSeconds Int @default(0)

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@index([userId])
}
